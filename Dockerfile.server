# In-cluster HTTP service (server.py) — the same code as the Lambda image
# (Dockerfile), for Kubernetes where Lambda isn't available (AKS). boto3 stays
# installed for S3 deployments; on Azure, storage_io uses Blob Storage.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY *.py ./

RUN useradd --uid 10001 --no-create-home app
USER 10001

EXPOSE 8080
CMD ["python", "server.py"]
